# Dot-prefixed top-level directories (agent tooling, local state — not part
# of the tracked prototype)
/.*/

# BMAD tooling itself (skills/scripts/config) — agent tooling, not this
# prototype (CLAUDE.md's own directory list). _bmad-output/ is NOT covered
# here: unlike this, it holds real deliverables (ratified PRD, architecture
# spine, epics, story records) this repo's own docs cite as authoritative.
_bmad

# macOS
.DS_Store

# Playwright MCP browser-automation captures — logs/snapshots can leak real
# hostnames/product names (confidentiality register, CLAUDE.md)
.playwright-mcp/

# Go tool binaries — build with `go build`/`go run`, don't commit
fabric-network/tools/ccdeploy/ccdeploy
fabric-network/tools/jcsverify/jcsverify
fabric-network/tools/netjoin/netjoin
fabric-network/tools/pilscan/pilscan
fabric-network/tools/raftfaulttest/raftfaulttest
fabric-network/tools/tenantprovision/tenantprovision
integration-bridge/integrationbridge

# Node (qa-tests/performance Caliper workspace — see RESULTS.md §5.1 before
# reinstalling: node_modules/ here is hand-patched for mutual TLS)
node_modules/
npm-debug.log*

# IPFS Private Cluster — regenerable data volumes if ever run outside Docker
ipfs-cluster/data/
ipfs-cluster/*/data/

# caliper-dashboard's live CLI tail source (Story 2.2) -- the operator
# redirects a real Caliper run's stdout here; never a committed artifact
caliper-run.log

# Note: fabric-network/ has its own nested .gitignore for generated crypto
# material, channel blocks, chaincode vendor/package artifacts, etc.

